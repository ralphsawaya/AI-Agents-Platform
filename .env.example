# Groq API key (optional — forwarded to agent subprocesses)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API key (optional — for teams using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB — local platform database (defaults to localhost if not set)
# MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas — trip agent data (required for Trip Planner + Atlas MCP)
# ATLAS_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

# LLM settings (optional overrides)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.3
# MAX_TOKENS=2048
