# Groq API key (optional — forwarded to agent subprocesses)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic API key (optional — for teams using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MongoDB — single local instance at 127.0.0.1:55440
# Platform database: agent_platform
MONGODB_URI=mongodb://127.0.0.1:55440/?directConnection=true

# Trip agent database on the same instance: trip_data
ATLAS_MONGODB_URI=mongodb://127.0.0.1:55440/?directConnection=true

# Voyage AI — semantic embeddings for Trip Agents vector search
# VOYAGE_AI_API_KEY=your_voyage_api_key_here

# LLM settings (optional overrides)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0.3
# MAX_TOKENS=2048
